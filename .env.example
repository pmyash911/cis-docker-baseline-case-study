# Zoho MCP endpoints — server-only. The access token is embedded in each URL.
ZOHO_MCP_URL=
ZOHO_CRM_URL=
ZOHO_LEAD_URL=
ZOHO_EMAIL_URL=
ZOHO_DEAL_URL=
ZOHO_ACCOUNT_URL=
ZOHO_ACTIVITY_URL=
ZOHO_NOTES_URL=
HEYREACH_API_KEY=

# ── Dossier delivery pipeline (see DOSSIER-PIPELINE.md) ─────────────────────
# Public origin used inside emails + signed download links.
SITE_URL=https://yalgar.com
# 32+ byte HMAC key. Rotating it revokes every outstanding dossier link.
DOSSIER_SIGNING_SECRET=
# Sender used by Zoho CRM sendMail. Must be a CRM user or verified sender alias.
DOSSIER_FROM_EMAIL=
DOSSIER_FROM_NAME=Yalgar Consulting
# Internal BCC / lead alert address.
DOSSIER_NOTIFY_EMAIL=inquiry@yalgar.com
# 1 = validate + log only (no CRM writes, no email). 0 = live.
DOSSIER_DRY_RUN=1
# 1 = also email a copy (requires a verified sender; see DOSSIER-PIPELINE.md).
DOSSIER_SEND_EMAIL=0

# Optional cookieless visitor analytics (leave empty to disable).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: Zoho CRM OAuth — only needed by scripts/delete-zoho-test-leads.mjs
# (MCP servers expose no delete tool). Self Client at https://api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_HOST=accounts.zoho.com
ZOHO_API_HOST=www.zohoapis.com

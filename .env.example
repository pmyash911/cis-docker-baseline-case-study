# Copy to .env and fill in only what you need.
# The public repo defaults to dry-run: no CRM writes, no email.

SITE_URL=http://localhost:3000

# Dossier signing key (32+ random bytes). Required for signed download links.
DOSSIER_SIGNING_SECRET=

# Optional CRM + email integration (server-only). Leave blank to stay in dry-run.
ZOHO_CRM_URL=
ZOHO_EMAIL_URL=
ZOHO_NOTES_URL=
DOSSIER_FROM_EMAIL=
DOSSIER_FROM_NAME=Yalgar Consulting
DOSSIER_NOTIFY_EMAIL=inquiry@yalgar.com
DOSSIER_DRY_RUN=1
DOSSIER_SEND_EMAIL=0

# Optional cookieless analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
